APP_ENV=dev
LOG_LEVEL=INFO
API_KEY=change-me

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/invoicing
REDIS_URL=redis://redis:6379/0

PROVIDER_AR_BASE_URL=http://provider-ar:8001
PROVIDER_BR_BASE_URL=http://provider-br:8002

PROVIDER_AR_TIMEOUT_MS=1500
PROVIDER_BR_TIMEOUT_MS=1500
PROVIDER_AR_MAX_RETRIES=3
PROVIDER_BR_MAX_RETRIES=3

RETRY_BASE_MS=200
RETRY_CAP_MS=1500
IDEMPOTENCY_LOCK_TTL_SECONDS=30
IDEMPOTENCY_RECORD_TTL_HOURS=24
PENDING_RECONCILIATION_MINUTES=15
